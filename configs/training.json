{
  "project_name": "CodeMixBridge",
  "seed": 3407,
  "language": "Kannada",
  "dataset": {
    "repo_id": "ai4bharat/IndicCMix",
    "filename": "ka.parquet",
    "split_ratios": {
      "train": 0.70,
      "val": 0.15,
      "test": 0.15
    }
  },
  "model": {
    "base_model": "unsloth/gemma-4-E2B-it-unsloth-bnb-4bit",
    "max_seq_length": 1024,
    "load_in_4bit": true,
    "chat_template": "gemma-4"
  },
  "lora": {
    "r": 16,
    "lora_alpha": 16,
    "lora_dropout": 0.0,
    "bias": "none",
    "finetune_language_layers": true,
    "finetune_attention_modules": true,
    "finetune_mlp_modules": true,
    "finetune_vision_layers": false
  },
  "training": {
    "max_steps": 1000,
    "learning_rate": 2e-4,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "warmup_ratio": 0.05,
    "optim": "adamw_8bit",
    "weight_decay": 0.01,
    "lr_scheduler_type": "cosine",
    "logging_steps": 5,
    "output_dir": "artifacts/adapters/gemma_4_kannada_lora",
    "report_to": "none"
  },
  "controlled_experiment": {
    "enabled": true,
    "experiment_b": {
      "r": 16,
      "lora_alpha": 16,
      "max_steps": 1000,
      "learning_rate": 2e-4,
      "output_dir": "artifacts/adapters/gemma_4_kannada_lora_r16"
    }
  }
}
